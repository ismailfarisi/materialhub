# MaterialHub backend — environment variables
#
# Copy this file to `backend/.env` and fill in the secrets.
# The `.env` file is gitignored and auto-loaded by docker-compose
# (and by Bun via `bun run --env-file .env` for local dev outside docker).
#
# Only the variables listed as (required) MUST be set.
# Everything else has a sensible development default baked into @materialhub/config.

# ─────────────────────────────────────────────────────────────
# Runtime
# ─────────────────────────────────────────────────────────────
NODE_ENV=development

# ─────────────────────────────────────────────────────────────
# Database (Postgres)
# Defaults work for the docker-compose postgres service.
# ─────────────────────────────────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USERNAME=materialhub
DB_PASSWORD=materialhub
DB_NAME=materialhub

# ─────────────────────────────────────────────────────────────
# Redis (cache + BullMQ + rate limiting)
# ─────────────────────────────────────────────────────────────
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# REDIS_PASSWORD=

# BullMQ uses redis://<host>:<port> derived from REDIS_HOST/REDIS_PORT by default.
# Override only if BullMQ should use a different Redis instance.
# BULLMQ_REDIS_URL=redis://localhost:6379

# ─────────────────────────────────────────────────────────────
# API port
# The backend runs as ONE process (backend/apps/api): the public API and every
# module (auth, product, order, vendor, notification, cms, integration).
#   cd backend/apps/api && bun run src/index.ts
# Module-to-module calls are served in-process, so the old per-service
# AUTH_PORT/AUTH_HOST ... INTEGRATION_HOST variables are no longer needed.
# ─────────────────────────────────────────────────────────────
GATEWAY_PORT=3000

# ─────────────────────────────────────────────────────────────
# JWT (user auth tokens)
# Dev defaults exist; set these in production.
# ─────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=dev-access-secret
JWT_REFRESH_SECRET=dev-refresh-secret

# ─────────────────────────────────────────────────────────────
# Internal module-to-module auth
# Shared secret passed in the `x-internal-secret` header on
# /internal/* endpoints (used by module-to-module calls, e.g. product → order
# verified-purchase checks, etc).
# ─────────────────────────────────────────────────────────────
INTERNAL_SERVICE_SECRET=dev-internal-secret

# ─────────────────────────────────────────────────────────────
# AWS (S3 media storage, SES email)
# Optional in dev — the media pipeline falls back gracefully.
# ─────────────────────────────────────────────────────────────
AWS_REGION=me-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_MEDIA_BUCKET=materialhub-media-dev
# CLOUDFRONT_DOMAIN — leave empty to serve media via S3 virtual-hosted URL
# (https://{bucket}.s3.{region}.amazonaws.com/{key}). Set when CloudFront
# is fronting the bucket.
CLOUDFRONT_DOMAIN=
# CLOUDFRONT_DISTRIBUTION_ID=
# S3_ENDPOINT — local dev only. Uncomment to store media on disk via the
# `local-s3` docker-compose service instead of AWS:
#   docker compose up -d local-s3 local-s3-init
# Objects land in backend/.local-s3/objects/<bucket>/. Also set
# AWS_ACCESS_KEY_ID=local-dev, AWS_SECRET_ACCESS_KEY=local-dev-secret and keep
# CLOUDFRONT_DOMAIN empty. Never set S3_ENDPOINT in staging/prod.
# S3_ENDPOINT=http://localhost:7070

# ─────────────────────────────────────────────────────────────
# Typesense (product search index)
# Defaults match the docker-compose typesense service.
# ─────────────────────────────────────────────────────────────
TYPESENSE_HOST=127.0.0.1
TYPESENSE_PORT=8108
TYPESENSE_PROTOCOL=http
TYPESENSE_API_KEY=dev-typesense-key
TYPESENSE_COLLECTION=products

# ─────────────────────────────────────────────────────────────
# Stripe (payments + vendor Connect payouts)
# Test-mode keys are safe in dev; use live keys only in production.
# ─────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_CONNECT_WEBHOOK_SECRET=
# Signing secret of the PaymentIntent webhook endpoint (POST /webhooks/stripe).
# Unset → that endpoint fails closed with 503. Locally: `stripe listen` prints one.
STRIPE_WEBHOOK_SECRET=

# Tamara direct online checkout
TAMARA_API_TOKEN=
TAMARA_API_BASE_URL=https://api-sandbox.tamara.co
TAMARA_NOTIFICATION_TOKEN=
TAMARA_SUCCESS_URL=http://localhost:4000/checkout/tamara/success
TAMARA_FAILURE_URL=http://localhost:4000/checkout/tamara/failure
TAMARA_CANCEL_URL=http://localhost:4000/checkout/tamara/cancel
TAMARA_NOTIFICATION_URL=http://localhost:3000/webhooks/tamara

# ─────────────────────────────────────────────────────────────
# WhatsApp (Meta Cloud API) — notification channel + OTP
# Leave ACCESS_TOKEN/PHONE_NUMBER_ID blank to disable the channel entirely
# (services boot with a stub dispatcher instead of crashing).
# ─────────────────────────────────────────────────────────────
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_BASE_URL=https://graph.facebook.com/v21.0
# Value we choose; Meta echoes it back during webhook GET verification.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# Meta app secret, used to verify X-Hub-Signature-256 on webhook POSTs.
WHATSAPP_APP_SECRET=
WHATSAPP_TEMPLATE_LANGUAGE=en
# Approved authentication-category template used for OTP codes.
WHATSAPP_OTP_TEMPLATE_NAME=otp_code

# Phone OTP provider selection: "twilio" (Twilio Verify), "whatsapp"
# (Meta authentication template + Redis-stored codes), or unset to disable.
# twilio | whatsapp | console (local dev only: prints codes to the API log; refused in production)
SMS_OTP_PROVIDER=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# ─────────────────────────────────────────────────────────────
# Vendor onboarding
# 32-byte hex key used to encrypt vendor bank account numbers at rest.
# ─────────────────────────────────────────────────────────────
VENDOR_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# ─────────────────────────────────────────────────────────────
# Shipping provider credentials encryption
# 64-char hex (32 bytes) key for AES-256-GCM encryption of
# per-vendor carrier credentials stored in vendor_carrier_accounts.
# ─────────────────────────────────────────────────────────────
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# ─────────────────────────────────────────────────────────────
# 2FA / TOTP
# ─────────────────────────────────────────────────────────────
TWO_FA_ENCRYPTION_KEY=dev-2fa-encryption-key-32bytes!!

# ─────────────────────────────────────────────────────────────
# Cache TTLs (seconds)
# ─────────────────────────────────────────────────────────────
CATEGORY_TREE_CACHE_TTL=3600
PRODUCT_DETAIL_CACHE_TTL=600
PRODUCT_LIST_CACHE_TTL=300

# ─────────────────────────────────────────────────────────────
# Inventory + low stock
# ─────────────────────────────────────────────────────────────
RESERVATION_EXPIRY_INTERVAL_MS=60000
LOW_STOCK_THRESHOLD_DEFAULT=10

# Google Drive API key for bulk catalog import folder-URL expansion.
# Optional. Without it, /drive/folders/* URLs fail with drive_api_not_configured.
# Create at https://console.cloud.google.com/apis/credentials with Drive API enabled.
GOOGLE_DRIVE_API_KEY=

# Storefront cache revalidation (optional). After admin edits to CMS pages,
# categories and the header menu, the API POSTs the affected cache tags to
# ${WEB_REVALIDATE_URL}/api/revalidate (and /api/revalidate/header-navigation)
# with header x-revalidate-secret. Leave either empty to skip; the storefront
# then refreshes on its cache TTLs. REVALIDATE_SECRET must equal the
# storefront's REVALIDATE_SECRET (apps/web/.env.local).
WEB_REVALIDATE_URL=
REVALIDATE_SECRET=
